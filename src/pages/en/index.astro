---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { getEntry } from 'astro:content';
const { name, tagline } = (await getEntry('site', 'site'))!.data;
---
<Base lang="en" title={name} description={tagline.en} route="home">
  <Hero lang="en" />
</Base>

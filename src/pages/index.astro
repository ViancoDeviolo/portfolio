---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { getEntry } from 'astro:content';
const { name, tagline } = (await getEntry('site', 'site'))!.data;
---
<Base lang="pt" title={name} description={tagline.pt} route="home">
  <Hero lang="pt" />
</Base>

---
// "Sempre / em obra." vira o par tipográfico da spec 3.2: antes da barra, serifado itálico; depois, Archivo.
const { id, text } = Astro.props as { id: string; text: string };
const [mao, ia] = text.split(' / ');
// Só palavra que vazaria da coluna em tipo gigante (ex.: "construction.", 13) ganha corpo menor; "conversar." (10) fica gigante.
const long = Math.max(...text.split(/[\s/]+/).map((w) => w.length)) > 11;
---
<h2 id={id} class:list={['title', { long }]}>
  <span class="t-mao">{mao}</span>{ia && <> <span class="t-ia">{ia}</span></>}
</h2>

---
import { getEntry } from 'astro:content';
import SkipLink from './SkipLink.astro';
import LangSwitch from './LangSwitch.astro';
import { ROUTES, type Lang } from '../lib/i18n';
const { lang, path, name } = Astro.props as { lang: Lang; path: string; name: string };
const { nav } = (await getEntry('site', 'site'))!.data;
---
<header class="site-header">
  <SkipLink lang={lang} />
  <div class="bar">
    <a class="name" href={ROUTES.home[lang]}>{name}</a>
    <nav class="nav" aria-label={lang === 'pt' ? 'Seções' : 'Sections'}>
      {nav.map((n) => <a class="pill" href={`${ROUTES.home[lang]}#${n.id}`}>{n.label[lang]}</a>)}
    </nav>
    <LangSwitch lang={lang} path={path} />
  </div>
</header>

<style>
  /* Mesmo fundo dividido da capa: no topo o cabeçalho some dentro dela. */
  .site-header {
    --accent: var(--c-ink);
    position: sticky;
    top: 0;
    z-index: 10;
    background: linear-gradient(to right, var(--c-mao) 50%, var(--c-ia) 50%);
    color: var(--c-ink);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: min(var(--s-4), 5vw);
    height: var(--header-h);
    padding-inline: var(--edge);
  }

  .name {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-size: var(--t-small);
    font-weight: 600;
    text-decoration: none;
  }

  /* Até o menu do celular (Task 11), as pílulas aparecem só onde cabem no centro. */
  .nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .nav {
      position: absolute;
      left: 50%;
      translate: -50% 0;
      display: flex;
      gap: var(--s-2);
    }
  }

  .pill,
  .bar :global(.lang-switch) {
    min-height: 2.25rem;
    padding-inline: var(--s-4);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--c-ink);
    transition: background-color var(--dur-hover) ease, color var(--dur-hover) ease;
  }

  .bar :global(.lang-switch) {
    border: 0;
    background: var(--c-ink);
    color: var(--c-paper);
  }

  @media (hover: hover) and (pointer: fine) {
    .pill:hover {
      background: var(--c-ink);
      color: var(--c-paper);
    }
  }
</style>

<script>
  import '../scripts/focus';
</script>

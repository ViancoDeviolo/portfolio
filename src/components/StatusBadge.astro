---
import { getEntry } from 'astro:content';
import { formatMonthYear } from '../lib/date';
import type { Project } from '../lib/schema';
import type { Lang } from '../lib/i18n';

interface Props {
  status: Project['status'];
  updated: string; // 'YYYY-MM'
  lang: Lang;
}

const { status, updated, lang } = Astro.props;
const { statusLabels } = (await getEntry('site', 'site'))!.data;
// Meio do mês ao meio-dia UTC: 'YYYY-MM' puro vira meia-noite UTC e cai no mês anterior em São Paulo.
const date = formatMonthYear(new Date(`${updated}-15T12:00:00Z`), lang);
---
<p class="status">
  <span class="badge" data-status={status}>{statusLabels[status][lang]}</span>
  <span class="updated">{lang === 'pt' ? `atualizado em ${date}` : `updated ${date}`}</span>
</p>

<style>
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    font-size: var(--t-label);
  }

  .badge {
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: var(--weight-strong);
  }

  .badge::before {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: var(--s-2);
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .badge:not([data-status='concluido'])::before {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .updated {
    color: var(--muted);
  }
</style>

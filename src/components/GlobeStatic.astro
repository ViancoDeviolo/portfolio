---
import { globeSvg } from '../lib/globe';
// Globo sem JS (e com movimento reduzido ou sem WebGL). Poucos pontos para o HTML ficar leve.
// Quando a cena 3D assume (html[data-globe-live]), ele some num cruzamento com o canvas, sem sair do layout:
// a cena lê a posição dele para desenhar o globo no mesmo lugar.
const svg = globeSvg(900, 160, 0.4);
---
<div class="globe-static" data-globe-static data-critter-avoid set:html={svg} />

<style>
  .globe-static {
    transition: opacity 400ms var(--ease-out);
  }

  :global(html[data-globe-live]) .globe-static {
    opacity: 0;
  }
</style>

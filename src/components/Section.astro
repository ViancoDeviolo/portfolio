---
import { getEntry } from 'astro:content';
import Title from './Title.astro';
import type { Lang, SectionId } from '../lib/i18n';

interface Props {
  id: SectionId;
  lang: Lang;
  tone: 'mao' | 'ia' | 'split' | 'ink'; // fundo da tela; o cabeçalho copia o tom (scripts/header-tone.ts)
  heading?: boolean; // false: a tela desenha o próprio h2
}

const { id, lang, tone, heading = true } = Astro.props;
const { kicker, title } = (await getEntry('site', 'site'))!.data.sections[id];
---
<section id={id} class="screen" data-tone={tone} aria-labelledby={`${id}-title`}>
  {heading && (
    <>
      <p class="eyebrow kicker">{kicker[lang]}</p>
      <Title id={`${id}-title`} text={title[lang]} />
    </>
  )}
  <slot />
</section>

---
import { getEntry } from 'astro:content';
import { ROUTES, type Lang } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';
const { lang, path } = Astro.props as { lang: Lang; path: string };
const { name, ui } = (await getEntry('site', 'site'))!.data;
const links = [
  { href: ROUTES.privacy[lang], label: lang === 'pt' ? 'Privacidade' : 'Privacy' },
  { href: ROUTES.terms[lang], label: lang === 'pt' ? 'Termos de uso' : 'Terms of use' },
];
---
<footer class="site-footer" data-tone="ink">
  <p>{name} · {ui.footerNote[lang]}</p>
  <ul>
    {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
  </ul>
  <LangSwitch lang={lang} path={path} />
</footer>

<style>
  /* Com a tela 06, o único fundo preto do site (spec 3.1). */
  .site-footer {
    --accent: var(--c-mao);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-5) var(--edge);
    background: var(--c-ink);
    color: color-mix(in srgb, var(--c-paper) 75%, var(--c-ink));
    font-size: var(--t-small);
  }

  p {
    margin-right: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--c-paper);
    }
  }
</style>

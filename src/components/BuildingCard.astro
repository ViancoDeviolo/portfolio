---
import { getEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const { studyingNow } = (await getEntry('site', 'site'))!.data;
const L = {
  pt: { title: 'Em construção', lead: 'Estudando agora' },
  en: { title: 'In progress', lead: 'Studying now' },
}[lang];
---
<article class="building-card" aria-labelledby="building-title">
  <h3 id="building-title">{L.title}</h3>
  <p class="eyebrow">{L.lead}</p>
  <ul>
    {studyingNow.map((s) => <li>{s[lang]}</li>)}
  </ul>
</article>

<style>
  .building-card {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
    border: 1px dashed color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: var(--radius);
  }

  ul {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding-left: 1.1em;
  }

  li::marker {
    color: var(--accent);
  }
</style>

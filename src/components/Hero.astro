---
import { Picture } from 'astro:assets';
import { getEntry } from 'astro:content';
import casual from '../assets/dupla/casual.png';
import terno from '../assets/dupla/terno.png';
import Halftone from './Halftone.astro';
import GlobeStatic from './GlobeStatic.astro';
import GlobeScene from './islands/GlobeScene';
import { formatMonthYearShort } from '../lib/date';
import type { Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const { heroAlt: ALT, heroBadge, heroLabels } = (await getEntry('site', 'site'))!.data;
// Cada foto mede 0,45 × a altura da capa (cerca de 370 px a 1440×900); no celular, cerca de 45vw.
const sizes = '(min-width: 48rem) 380px, 45vw';
---
<section id="top" class="hero" data-hero data-tone="hero" aria-labelledby="hero-name">
  <Halftone />
  <GlobeStatic />
  <div id="globe-stage"><GlobeScene client:only="react" /></div>

  <p class="note" data-living-note>{heroBadge[lang]} · {formatMonthYearShort(new Date(), lang)}</p>
  <h1 id="hero-name" class="name" data-hero-name><span class="t-mao">Lucas</span> <span class="t-ia">Cruz</span></h1>

  <div class="duo">
    <Picture class="figure casual" src={casual} alt={ALT.casual[lang]} formats={['avif', 'webp']}
      widths={[320, 480, 640, 774]} sizes={sizes} loading="eager" fetchpriority="high" />
    <Picture class="figure terno" src={terno} alt={ALT.terno[lang]} formats={['avif', 'webp']}
      widths={[320, 480, 640, 774, 1086]} sizes={sizes} loading="eager" />
  </div>

  <a class="label mao" href="#fundamentals">
    <span class="label-title t-mao">{heroLabels.mao.title[lang]}</span>
    <span class="label-sub">{heroLabels.mao.sub[lang]}</span>
  </a>
  <a class="label ia" href="#ai">
    <span class="label-title t-ia">{heroLabels.ia.title[lang]}</span>
    <span class="label-sub">{heroLabels.ia.sub[lang]}</span>
  </a>
</section>

<style>
  /* Camadas, de trás para frente: fundo dividido, retícula, globo, nome, fotos, textos. */
  .hero {
    --accent: var(--c-ink); /* anel de foco preto sobre amarelo e laranja */
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto 1fr auto;
    column-gap: var(--s-5);
    min-height: max(36rem, calc(100svh - var(--header-h)));
    padding: var(--s-3) var(--edge) var(--s-7);
    /* O amarelo vai até a borda direita da retícula, onde os pontos laranja já se fundiram. */
    --hero-bg: linear-gradient(to right, var(--c-mao) calc(50% + var(--band) / 2), var(--c-ia) 0);
    background: var(--hero-bg);
    color: var(--c-ink);
  }

  .hero :global([data-halftone]),
  .hero :global([data-globe-static]) {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  /* Cena 3D (islands/GlobeScene): um canvas fixo atrás do conteúdo, compartilhado pela capa e pelas telas 02 e 03.
     Ele fica sob o texto e sobre os fundos; por isso, com a cena viva, a capa sai do isolamento e o fundo dela
     desce para uma camada abaixo do canvas (Home.astro faz o mesmo com as telas 02 e 03). */
  #globe-stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  :global(html[data-globe-live]) #globe-stage {
    opacity: 1;
  }

  :global(html[data-globe-live]) .hero {
    isolation: auto;
    background: none;
  }

  :global(html[data-globe-live]) .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--hero-bg);
  }

  .hero :global([data-halftone]) {
    inset-block: 0;
    left: 50%;
    width: var(--band);
    height: 100%;
    translate: -50% 0;
  }

  .hero :global([data-globe-static]) {
    top: 12%;
    left: 50%;
    height: 80%;
    aspect-ratio: 1;
    max-width: 92vw;
    translate: -50% 0;
  }

  .hero :global([data-globe-static] svg) {
    width: 100%;
    height: 100%;
  }

  .note {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-label);
    letter-spacing: 0.01em;
    max-width: none;
  }

  .note::before {
    content: '';
    flex: none;
    width: 0.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
  }

  /* O nome fica atrás das fotos: "Lucas" no amarelo, "Cruz" no laranja. */
  .name {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.22em; /* as costas se encontram no centro: a cabeça casual cobre o "s", a do terno o "C" */
    margin-top: var(--s-3);
    font-size: min(16.5vw, 30svh);
    line-height: 0.9;
    letter-spacing: normal;
    text-wrap: nowrap;
  }

  .duo {
    position: absolute;
    z-index: 1;
    bottom: -16%; /* a capa corta as pernas, como no esboço */
    left: 50%;
    /* Da altura da capa; numa tela estreita, o que couber na largura (cada foto tem 0,45 × a altura). */
    height: min(100%, (100vw - 2 * var(--edge)) / 0.9);
    width: max-content;
    display: flex;
    translate: -50% 0;
    pointer-events: none;
  }

  /* Os recortes têm margens transparentes largas: corta para as costas se encontrarem no centro.
     A máscara apaga as bordas, onde o ruído do alfa do recorte desenharia uma linha. */
  .duo :global(picture) {
    height: 100%;
  }

  .figure {
    height: 100%;
    width: auto;
    max-width: none; /* o max-width global das imagens esmagaria a foto quando a capa é estreita */
    aspect-ratio: 0.45;
    object-fit: cover;
    -webkit-mask-image: var(--fade-x);
    mask-image: var(--fade-x);
  }

  .casual {
    --fade-x: linear-gradient(to right, transparent, #000 15%, #000 99%, transparent);
    object-position: 3% 0;
  }

  .terno {
    --fade-x: linear-gradient(to left, transparent, #000 15%, #000 99%, transparent);
    object-position: 84% 0;
  }

  .label {
    position: relative;
    z-index: 2;
    grid-row: 4;
    align-self: end;
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
    border-radius: 0.25rem;
  }

  .label.ia {
    justify-self: end;
    text-align: right;
  }

  .label-title {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    line-height: 1;
  }

  .label.mao .label-title {
    font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem); /* o serifado é menor no olho: compensa */
  }

  .label-sub {
    font-size: var(--t-small);
  }

  @media (hover: hover) and (pointer: fine) {
    .label:hover .label-title {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.12em;
    }
  }
</style>

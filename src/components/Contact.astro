---
import { getEntry } from 'astro:content';
import Section from './Section.astro';
import type { Lang } from '../lib/i18n';

const { lang } = Astro.props as { lang: Lang };
const { contact } = (await getEntry('site', 'site'))!.data;
const L = {
  pt: { email: 'E-mail', at: 'arroba', cv: 'Currículo', cvLink: 'Baixar PDF', cvHref: '/lucas-cruz-cv.pdf' },
  en: { email: 'Email', at: 'at', cv: 'Résumé', cvLink: 'Download PDF', cvHref: '/lucas-cruz-cv-en.pdf' },
}[lang];
const ext = { rel: 'noopener noreferrer' };
const handle = (url: string) => new URL(url).pathname.replace(/^\/(in\/)?|\/$/g, '');
---
<Section id="contact" lang={lang}>
  <dl class="rows">
    <div class="row">
      <dt class="eyebrow">{L.email}</dt>
      <dd>
        {/* Sem href até o JS montar o endereço; sem JS vale o texto do noscript. */}
        <a class="email" data-user={contact.emailUser} data-domain={contact.emailDomain} hidden></a>
        <noscript>{contact.emailUser} [{L.at}] {contact.emailDomain}</noscript>
      </dd>
    </div>
    <div class="row">
      <dt class="eyebrow">LinkedIn</dt>
      <dd><a href={contact.linkedin} {...ext}>{handle(contact.linkedin)}</a></dd>
    </div>
    <div class="row">
      <dt class="eyebrow">GitHub</dt>
      <dd><a href={contact.github} {...ext}>{handle(contact.github)}</a></dd>
    </div>
    <div class="row">
      <dt class="eyebrow">{L.cv}</dt>
      <dd><a href={L.cvHref} download>{L.cvLink}</a></dd>
    </div>
  </dl>
</Section>

<script>
  import '../scripts/email';
</script>

<style>
  dd {
    font-size: var(--t-h3);
    font-weight: var(--weight-strong);
    overflow-wrap: anywhere;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }

  a[hidden] {
    display: none;
  }
</style>
